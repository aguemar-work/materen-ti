<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Control de credenciales — TI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
  <style>
    :root {
      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;

      --color-bg: #f0f2f7;
      --color-bg-elevated: #ffffff;
      --color-bg-subtle: #f8f9fc;
      --color-bg-hover: #eef1f8;

      --color-text-primary: #0f172a;
      --color-text-secondary: #64748b;
      --color-text-tertiary: #94a3b8;
      --color-text-inverse: #ffffff;

      --color-border: #e2e8f0;
      --color-border-subtle: #f1f5f9;

      --color-accent: #4f46e5;
      --color-accent-hover: #4338ca;
      --color-accent-subtle: #eef2ff;
      --color-accent-text: #4338ca;

      --color-danger: #dc2626;
      --color-danger-bg: #fef2f2;
      --color-danger-border: #fecaca;

      --color-success-bg: #ecfdf5;
      --color-success-text: #047857;
      --color-warning-bg: #fffbeb;
      --color-warning-text: #b45309;
      --color-neutral-bg: #f1f5f9;
      --color-neutral-text: #475569;

      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 4px 16px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 12px 40px rgba(15, 23, 42, 0.12);

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 20px;

      --header-h: 64px;
      --max-w: 1280px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      font-size: 14px;
      color: var(--color-text-primary);
      background: var(--color-bg);
      line-height: 1.5;
      min-height: 100vh;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ── Header ── */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      height: var(--header-h);
      background: var(--color-bg-elevated);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
    }

    .header-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--color-accent) 0%, #7c3aed 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 20px;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
    }

    .brand-text h1 {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .brand-text span {
      font-size: 12px;
      color: var(--color-text-secondary);
    }

    /* ── Layout ── */
    .page {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.5rem;
    }

    /* ── Stats ── */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 1.25rem;
    }

    .stat-card {
      background: var(--color-bg-elevated);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1rem 1.15rem;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s, transform 0.2s;
    }

    .stat-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }

    .stat-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .stat-icon.total { background: var(--color-accent-subtle); color: var(--color-accent); }
    .stat-icon.active { background: var(--color-success-bg); color: var(--color-success-text); }
    .stat-icon.inactive { background: var(--color-neutral-bg); color: var(--color-neutral-text); }
    .stat-icon.suspended { background: var(--color-warning-bg); color: var(--color-warning-text); }

    .stat-info .stat-value {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .stat-info .stat-label {
      font-size: 12px;
      color: var(--color-text-secondary);
      margin-top: 2px;
    }

    /* ── Main card ── */
    .card {
      background: var(--color-bg-elevated);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .card-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--color-border-subtle);
      flex-wrap: wrap;
    }

    .toolbar-title {
      font-size: 15px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .badge-count {
      background: var(--color-accent-subtle);
      color: var(--color-accent-text);
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 11px;
      font-weight: 600;
    }

    .toolbar-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* ── Buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg-elevated);
      color: var(--color-text-primary);
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font-sans);
      transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
      white-space: nowrap;
    }

    .btn:hover {
      background: var(--color-bg-subtle);
      border-color: #cbd5e1;
    }

    .btn-primary {
      background: var(--color-accent);
      color: var(--color-text-inverse);
      border-color: var(--color-accent);
      box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);
    }

    .btn-primary:hover {
      background: var(--color-accent-hover);
      border-color: var(--color-accent-hover);
    }

    /* ── Filters ── */
    .filters {
      display: flex;
      gap: 8px;
      padding: 0.85rem 1.25rem;
      background: var(--color-bg-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
      flex-wrap: wrap;
    }

    .search-wrap {
      flex: 2;
      min-width: 200px;
      position: relative;
    }

    .search-wrap i {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-text-tertiary);
      font-size: 16px;
      pointer-events: none;
    }

    .search-wrap input {
      width: 100%;
      padding: 8px 10px 8px 34px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 13px;
      background: var(--color-bg-elevated);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .filters select {
      flex: 1;
      min-width: 140px;
      padding: 8px 10px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 13px;
      background: var(--color-bg-elevated);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      cursor: pointer;
    }

    .search-wrap input:focus,
    .filters select:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    /* ── Table ── */
    .table-wrap { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th {
      text-align: left;
      padding: 10px 1.25rem;
      background: var(--color-bg-subtle);
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-secondary);
      font-weight: 600;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    td {
      padding: 12px 1.25rem;
      border-bottom: 1px solid var(--color-border-subtle);
      vertical-align: middle;
    }

    tbody tr {
      transition: background 0.12s;
    }

    tbody tr:hover td {
      background: var(--color-bg-hover);
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-name { font-weight: 600; font-size: 13px; }
    .user-login { font-size: 12px; color: var(--color-text-secondary); }

    .area-main { font-weight: 500; }
    .area-sub { font-size: 12px; color: var(--color-text-secondary); }

    .text-muted { color: var(--color-text-secondary); }

    /* ── Status & pills ── */
    .status {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .status::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .s-activo { background: var(--color-success-bg); color: var(--color-success-text); }
    .s-inactivo { background: var(--color-neutral-bg); color: var(--color-neutral-text); }
    .s-suspendido { background: var(--color-warning-bg); color: var(--color-warning-text); }

    .pills { display: flex; flex-wrap: wrap; gap: 4px; }

    .pill {
      background: var(--color-accent-subtle);
      color: var(--color-accent-text);
      padding: 2px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 500;
    }

    .pill-more {
      background: var(--color-neutral-bg);
      color: var(--color-neutral-text);
    }

    /* ── Avatar ── */
    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--color-accent-subtle), #e0e7ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 12px;
      color: var(--color-accent);
      flex-shrink: 0;
      border: 2px solid var(--color-bg-elevated);
      box-shadow: 0 0 0 1px var(--color-border);
    }

    .avatar.sm { width: 32px; height: 32px; font-size: 11px; }

    /* ── Actions ── */
    .actions { display: flex; gap: 2px; }

    .icon-btn {
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--color-text-secondary);
      padding: 6px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      font-size: 17px;
      transition: background 0.12s, color 0.12s;
    }

    .icon-btn:hover {
      background: var(--color-bg-subtle);
      color: var(--color-text-primary);
    }

    .icon-btn.danger:hover {
      color: var(--color-danger);
      background: var(--color-danger-bg);
    }

    /* ── Empty state ── */
    .empty {
      text-align: center;
      padding: 3.5rem 1.5rem;
      color: var(--color-text-secondary);
    }

    .empty-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 1rem;
      border-radius: 50%;
      background: var(--color-bg-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      color: var(--color-text-tertiary);
    }

    .empty h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--color-text-primary);
      margin-bottom: 6px;
    }

    .empty p { font-size: 13px; margin-bottom: 1.25rem; }

    .no-results {
      text-align: center;
      padding: 2.5rem;
      color: var(--color-text-secondary);
    }

    /* ── Modals ── */
    .modal-bg {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 1rem;
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(12px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal {
      background: var(--color-bg-elevated);
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border);
      padding: 1.5rem;
      width: 100%;
      max-width: 540px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      animation: slideUp 0.25s ease;
    }

    .modal-title {
      font-size: 17px;
      font-weight: 600;
      margin-bottom: 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      letter-spacing: -0.01em;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-group.full { grid-column: 1 / -1; }

    label {
      font-size: 12px;
      color: var(--color-text-secondary);
      font-weight: 600;
    }

    .form-group input,
    .form-group select,
    .form-group textarea,
    .tool-input {
      padding: 8px 11px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 13px;
      background: var(--color-bg-elevated);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus,
    .tool-input:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .form-group textarea {
      resize: vertical;
      min-height: 72px;
    }

    .section-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--color-text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      grid-column: 1 / -1;
      margin-top: 4px;
      padding-top: 12px;
      border-top: 1px solid var(--color-border-subtle);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .section-label i { font-size: 14px; }

    .tools-list {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 8px;
      min-height: 4px;
    }

    .tool-tag {
      background: var(--color-accent-subtle);
      color: var(--color-accent-text);
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .tool-tag button {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--color-accent-text);
      padding: 0;
      line-height: 1;
      font-size: 15px;
      opacity: 0.7;
    }

    .tool-tag button:hover { opacity: 1; }

    .tool-row { display: flex; gap: 8px; }
    .tool-row .tool-input { flex: 1; }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border-subtle);
    }

    /* ── Detail modal ── */
    .detail-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 1.25rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .detail-header .avatar { width: 52px; height: 52px; font-size: 16px; }

    .detail-name { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; }
    .detail-role { font-size: 13px; color: var(--color-text-secondary); margin-top: 2px; }
    .detail-header .status { margin-left: auto; }

    .detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      font-size: 13px;
    }

    .detail-item label {
      display: block;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }

    .detail-item strong { font-weight: 600; }
    .detail-item.full { grid-column: 1 / -1; }

    .pass-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pass-row strong {
      font-family: var(--font-mono);
      letter-spacing: 1px;
      font-size: 13px;
    }

    .detail-notes {
      margin-top: 4px;
      line-height: 1.6;
      color: var(--color-text-secondary);
      background: var(--color-bg-subtle);
      padding: 10px 12px;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-subtle);
    }

    /* ── Toast ── */
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--color-text-primary);
      color: var(--color-text-inverse);
      padding: 10px 18px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 500;
      z-index: 200;
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: opacity 0.3s, transform 0.3s;
    }

    .toast i { font-size: 16px; color: #86efac; }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .stats-row { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 600px) {
      .page { padding: 1rem; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .form-grid { grid-template-columns: 1fr; }
      .detail-grid { grid-template-columns: 1fr; }
      .detail-header { flex-wrap: wrap; }
      .detail-header .status { margin-left: 0; }
      th, td { padding: 10px 12px; }
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <div class="brand">
        <div class="brand-icon"><i class="ti ti-shield-lock" aria-hidden="true"></i></div>
        <div class="brand-text">
          <h1>Sistema TI</h1>
          <span>Gestión de credenciales corporativas</span>
        </div>
      </div>
      <button class="btn btn-primary" onclick="openModal()">
        <i class="ti ti-plus" aria-hidden="true"></i> Nuevo usuario
      </button>
    </div>
  </header>

  <main class="page">
    <h2 class="sr-only">Sistema de control de credenciales de TI</h2>

    <div class="stats-row" id="stats-row">
      <div class="stat-card">
        <div class="stat-icon total"><i class="ti ti-users" aria-hidden="true"></i></div>
        <div class="stat-info">
          <div class="stat-value" id="stat-total">0</div>
          <div class="stat-label">Total usuarios</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon active"><i class="ti ti-circle-check" aria-hidden="true"></i></div>
        <div class="stat-info">
          <div class="stat-value" id="stat-activos">0</div>
          <div class="stat-label">Activos</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon inactive"><i class="ti ti-circle-x" aria-hidden="true"></i></div>
        <div class="stat-info">
          <div class="stat-value" id="stat-inactivos">0</div>
          <div class="stat-label">Inactivos</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon suspended"><i class="ti ti-alert-triangle" aria-hidden="true"></i></div>
        <div class="stat-info">
          <div class="stat-value" id="stat-suspendidos">0</div>
          <div class="stat-label">Suspendidos</div>
        </div>
      </div>
    </div>

    <div class="card" id="app">
      <div class="card-toolbar">
        <div class="toolbar-title">
          Inventario de usuarios
          <span class="badge-count" id="badge">0 usuarios</span>
        </div>
        <div class="toolbar-actions">
          <button class="btn" onclick="exportCSV()">
            <i class="ti ti-download" aria-hidden="true"></i> Exportar CSV
          </button>
        </div>
      </div>

      <div class="filters">
        <div class="search-wrap">
          <i class="ti ti-search" aria-hidden="true"></i>
          <input type="text" id="search" placeholder="Buscar por nombre, usuario, correo..." oninput="renderTable()">
        </div>
        <select id="filterArea" onchange="renderTable()">
          <option value="">Todas las áreas</option>
        </select>
        <select id="filterStatus" onchange="renderTable()">
          <option value="">Todos los estados</option>
          <option value="Activo">Activo</option>
          <option value="Inactivo">Inactivo</option>
          <option value="Suspendido">Suspendido</option>
        </select>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Área / Cargo</th>
              <th>Correo</th>
              <th>Accesos</th>
              <th>Estado</th>
              <th>Alta</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>

      <div class="empty" id="empty" style="display:none">
        <div class="empty-icon"><i class="ti ti-users" aria-hidden="true"></i></div>
        <h3>Sin usuarios registrados</h3>
        <p>Comienza agregando el primer usuario al inventario de credenciales.</p>
        <button class="btn btn-primary" onclick="openModal()">
          <i class="ti ti-plus" aria-hidden="true"></i> Agregar usuario
        </button>
      </div>
    </div>
  </main>

  <!-- Modal crear/editar -->
  <div class="modal-bg" id="modal" style="display:none" onclick="if(event.target===this)closeModal()">
    <div class="modal" role="dialog" aria-labelledby="modal-title-text">
      <div class="modal-title">
        <span id="modal-title-text">Nuevo usuario</span>
        <button class="icon-btn" onclick="closeModal()" aria-label="Cerrar"><i class="ti ti-x" aria-hidden="true"></i></button>
      </div>
      <div class="form-grid">
        <div class="form-group full"><span class="section-label"><i class="ti ti-user" aria-hidden="true"></i> Datos personales</span></div>
        <div class="form-group"><label>Nombre completo *</label><input id="f-nombre" placeholder="Ej. Juan Pérez"></div>
        <div class="form-group"><label>Área</label><input id="f-area" placeholder="Ej. Contabilidad"></div>
        <div class="form-group"><label>Cargo</label><input id="f-cargo" placeholder="Ej. Analista"></div>
        <div class="form-group"><label>Teléfono / interno</label><input id="f-telefono" placeholder="Ej. 064-123456"></div>

        <div class="form-group full"><span class="section-label"><i class="ti ti-key" aria-hidden="true"></i> Credenciales</span></div>
        <div class="form-group"><label>Usuario de sistema *</label><input id="f-usuario" placeholder="Ej. jperez"></div>
        <div class="form-group"><label>Contraseña</label><input id="f-password" type="password" placeholder="••••••••" autocomplete="new-password"></div>
        <div class="form-group full"><label>Correo corporativo</label><input id="f-correo" type="email" placeholder="jperez@empresa.com"></div>

        <div class="form-group full"><span class="section-label"><i class="ti ti-apps" aria-hidden="true"></i> Accesos a herramientas</span></div>
        <div class="form-group full">
          <label>Herramientas asignadas</label>
          <div class="tools-list" id="tools-list"></div>
          <div class="tool-row">
            <input class="tool-input" id="tool-input" placeholder="Ej. VPN, ERP, Active Directory..." onkeydown="if(event.key==='Enter')addTool()">
            <button class="btn" onclick="addTool()"><i class="ti ti-plus" aria-hidden="true"></i></button>
          </div>
        </div>

        <div class="form-group full"><span class="section-label"><i class="ti ti-settings" aria-hidden="true"></i> Administración</span></div>
        <div class="form-group">
          <label>Estado</label>
          <select id="f-estado">
            <option>Activo</option>
            <option>Inactivo</option>
            <option>Suspendido</option>
          </select>
        </div>
        <div class="form-group"><label>Fecha de alta</label><input id="f-alta" type="date"></div>
        <div class="form-group full"><label>Notas</label><textarea id="f-notas" placeholder="Observaciones del administrador..."></textarea></div>
      </div>
      <div class="modal-actions">
        <button class="btn" onclick="closeModal()">Cancelar</button>
        <button class="btn btn-primary" onclick="saveUser()"><i class="ti ti-device-floppy" aria-hidden="true"></i> Guardar usuario</button>
      </div>
    </div>
  </div>

  <!-- Modal detalle -->
  <div class="modal-bg" id="detail-modal" style="display:none" onclick="if(event.target===this)closeDetail()">
    <div class="modal" role="dialog">
      <div class="modal-title">
        <span>Detalle de usuario</span>
        <button class="icon-btn" onclick="closeDetail()" aria-label="Cerrar"><i class="ti ti-x" aria-hidden="true"></i></button>
      </div>
      <div id="detail-content"></div>
      <div class="modal-actions">
        <button class="btn" onclick="closeDetail()">Cerrar</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" style="display:none"></div>

  <script>
    let users = [];
    let editIndex = -1;
    let tempTools = [];

    const today = new Date().toISOString().split('T')[0];

    function esc(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getInitials(name) {
      return name.split(' ').filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
    }

    function statusClass(s) {
      return s === 'Activo' ? 's-activo' : s === 'Inactivo' ? 's-inactivo' : 's-suspendido';
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.innerHTML = '<i class="ti ti-check" aria-hidden="true"></i> ' + esc(msg);
      t.style.display = 'flex';
      t.style.opacity = '1';
      t.style.transform = 'translateY(0)';
      setTimeout(() => {
        t.style.opacity = '0';
        t.style.transform = 'translateY(8px)';
        setTimeout(() => t.style.display = 'none', 300);
      }, 2200);
    }

    function updateStats() {
      document.getElementById('stat-total').textContent = users.length;
      document.getElementById('stat-activos').textContent = users.filter(u => u.estado === 'Activo').length;
      document.getElementById('stat-inactivos').textContent = users.filter(u => u.estado === 'Inactivo').length;
      document.getElementById('stat-suspendidos').textContent = users.filter(u => u.estado === 'Suspendido').length;
      document.getElementById('badge').textContent = users.length + ' usuario' + (users.length !== 1 ? 's' : '');
    }

    function renderTable() {
      const q = document.getElementById('search').value.toLowerCase();
      const area = document.getElementById('filterArea').value;
      const status = document.getElementById('filterStatus').value;
      const filtered = users.filter(u => {
        const match = !q || (u.nombre + u.usuario + u.correo + u.area + u.cargo).toLowerCase().includes(q);
        const matchA = !area || u.area === area;
        const matchS = !status || u.estado === status;
        return match && matchA && matchS;
      });

      const tb = document.getElementById('tbody');
      const tableWrap = document.querySelector('.table-wrap');
      updateStats();

      if (users.length === 0) {
        document.getElementById('empty').style.display = 'block';
        tableWrap.style.display = 'none';
        document.querySelector('.filters').style.display = 'none';
        tb.innerHTML = '';
        return;
      }

      document.getElementById('empty').style.display = 'none';
      tableWrap.style.display = 'block';
      document.querySelector('.filters').style.display = 'flex';

      if (filtered.length === 0) {
        tb.innerHTML = '<tr><td colspan="7"><div class="no-results"><i class="ti ti-search-off" style="font-size:28px;display:block;margin-bottom:8px;opacity:0.4" aria-hidden="true"></i>No se encontraron resultados con los filtros actuales.</div></td></tr>';
        updateAreaFilter();
        return;
      }

      tb.innerHTML = filtered.map(u => {
        const ri = users.indexOf(u);
        const tools = u.herramientas || [];
        const toolsHtml = tools.slice(0, 3).map(h => `<span class="pill">${esc(h)}</span>`).join('')
          + (tools.length > 3 ? `<span class="pill pill-more">+${tools.length - 3}</span>` : '');

        return `<tr>
          <td>
            <div class="user-cell">
              <div class="avatar sm">${esc(getInitials(u.nombre))}</div>
              <div>
                <div class="user-name">${esc(u.nombre)}</div>
                <div class="user-login">${esc(u.usuario)}</div>
              </div>
            </div>
          </td>
          <td>
            <div class="area-main">${esc(u.area) || '—'}</div>
            <div class="area-sub">${esc(u.cargo)}</div>
          </td>
          <td class="text-muted">${esc(u.correo) || '—'}</td>
          <td><div class="pills">${toolsHtml || '<span class="text-muted">—</span>'}</div></td>
          <td><span class="status ${statusClass(u.estado)}">${esc(u.estado)}</span></td>
          <td class="text-muted" style="white-space:nowrap">${esc(u.alta) || '—'}</td>
          <td>
            <div class="actions">
              <button class="icon-btn" title="Ver detalle" onclick="viewDetail(${ri})"><i class="ti ti-eye" aria-hidden="true"></i></button>
              <button class="icon-btn" title="Editar" onclick="editUser(${ri})"><i class="ti ti-edit" aria-hidden="true"></i></button>
              <button class="icon-btn danger" title="Eliminar" onclick="deleteUser(${ri})"><i class="ti ti-trash" aria-hidden="true"></i></button>
            </div>
          </td>
        </tr>`;
      }).join('');

      updateAreaFilter();
    }

    function updateAreaFilter() {
      const sel = document.getElementById('filterArea');
      const current = sel.value;
      const areas = [...new Set(users.map(u => u.area).filter(Boolean))].sort();
      sel.innerHTML = '<option value="">Todas las áreas</option>'
        + areas.map(a => `<option value="${esc(a)}"${a === current ? ' selected' : ''}>${esc(a)}</option>`).join('');
    }

    function openModal(edit = false) {
      editIndex = edit;
      document.getElementById('modal-title-text').textContent = edit !== false ? 'Editar usuario' : 'Nuevo usuario';
      tempTools = [];
      if (edit !== false) {
        const u = users[edit];
        document.getElementById('f-nombre').value = u.nombre;
        document.getElementById('f-area').value = u.area;
        document.getElementById('f-cargo').value = u.cargo;
        document.getElementById('f-telefono').value = u.telefono;
        document.getElementById('f-usuario').value = u.usuario;
        document.getElementById('f-password').value = u.password;
        document.getElementById('f-correo').value = u.correo;
        document.getElementById('f-estado').value = u.estado;
        document.getElementById('f-alta').value = u.alta;
        document.getElementById('f-notas').value = u.notas;
        tempTools = [...(u.herramientas || [])];
      } else {
        ['f-nombre', 'f-area', 'f-cargo', 'f-telefono', 'f-usuario', 'f-password', 'f-correo', 'f-notas']
          .forEach(id => document.getElementById(id).value = '');
        document.getElementById('f-estado').value = 'Activo';
        document.getElementById('f-alta').value = today;
        tempTools = [];
      }
      renderToolPills();
      document.getElementById('modal').style.display = 'flex';
    }

    function closeModal() { document.getElementById('modal').style.display = 'none'; }

    function addTool() {
      const inp = document.getElementById('tool-input');
      const val = inp.value.trim();
      if (val && !tempTools.includes(val)) { tempTools.push(val); renderToolPills(); }
      inp.value = '';
    }

    function removeTool(i) { tempTools.splice(i, 1); renderToolPills(); }

    function renderToolPills() {
      document.getElementById('tools-list').innerHTML = tempTools.map((t, i) =>
        `<span class="tool-tag">${esc(t)}<button type="button" onclick="removeTool(${i})" aria-label="Quitar">×</button></span>`
      ).join('');
    }

    function saveUser() {
      const nombre = document.getElementById('f-nombre').value.trim();
      const usuario = document.getElementById('f-usuario').value.trim();
      if (!nombre || !usuario) { showToast('Nombre y usuario son obligatorios'); return; }

      const u = {
        nombre,
        area: document.getElementById('f-area').value.trim(),
        cargo: document.getElementById('f-cargo').value.trim(),
        telefono: document.getElementById('f-telefono').value.trim(),
        usuario,
        password: document.getElementById('f-password').value.trim(),
        correo: document.getElementById('f-correo').value.trim(),
        herramientas: [...tempTools],
        estado: document.getElementById('f-estado').value,
        alta: document.getElementById('f-alta').value,
        notas: document.getElementById('f-notas').value.trim(),
      };

      if (editIndex !== false && editIndex >= 0) {
        users[editIndex] = u;
        showToast('Usuario actualizado');
      } else {
        users.push(u);
        showToast('Usuario registrado');
      }
      closeModal();
      renderTable();
    }

    function editUser(i) { openModal(i); }

    function deleteUser(i) {
      if (!confirm('¿Eliminar a ' + users[i].nombre + '? Esta acción no se puede deshacer.')) return;
      users.splice(i, 1);
      showToast('Usuario eliminado');
      renderTable();
    }

    let currentPw = '';

    function viewDetail(i) {
      const u = users[i];
      currentPw = u.password || '';
      const toolsHtml = (u.herramientas || []).map(h => `<span class="pill">${esc(h)}</span>`).join('') || '—';

      document.getElementById('detail-content').innerHTML = `
        <div class="detail-header">
          <div class="avatar">${esc(getInitials(u.nombre))}</div>
          <div>
            <div class="detail-name">${esc(u.nombre)}</div>
            <div class="detail-role">${esc(u.cargo) || ''}${u.area ? ' · ' + esc(u.area) : ''}</div>
          </div>
          <span class="status ${statusClass(u.estado)}">${esc(u.estado)}</span>
        </div>
        <div class="detail-grid">
          <div class="detail-item"><label>Correo</label><strong>${esc(u.correo) || '—'}</strong></div>
          <div class="detail-item"><label>Teléfono</label><strong>${esc(u.telefono) || '—'}</strong></div>
          <div class="detail-item"><label>Usuario de sistema</label><strong>${esc(u.usuario)}</strong></div>
          <div class="detail-item">
            <label>Contraseña</label>
            <div class="pass-row">
              <strong id="pw-show">••••••••</strong>
              <button class="icon-btn" onclick="togglePw()" aria-label="Mostrar contraseña"><i class="ti ti-eye" id="pw-icon" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="detail-item full"><label>Fecha de alta</label><strong>${esc(u.alta) || '—'}</strong></div>
          <div class="detail-item full"><label>Accesos</label><div class="pills" style="margin-top:4px">${toolsHtml}</div></div>
          ${u.notas ? `<div class="detail-item full"><label>Notas</label><div class="detail-notes">${esc(u.notas)}</div></div>` : ''}
        </div>
      `;
      document.getElementById('detail-modal').style.display = 'flex';
    }

    function togglePw() {
      const el = document.getElementById('pw-show');
      const ic = document.getElementById('pw-icon');
      if (el.textContent === '••••••••') {
        el.textContent = currentPw || '—';
        ic.className = 'ti ti-eye-off';
      } else {
        el.textContent = '••••••••';
        ic.className = 'ti ti-eye';
      }
    }

    function closeDetail() { document.getElementById('detail-modal').style.display = 'none'; }

    function exportCSV() {
      if (!users.length) { showToast('No hay datos para exportar'); return; }
      const headers = ['Nombre', 'Área', 'Cargo', 'Teléfono', 'Usuario', 'Contraseña', 'Correo', 'Herramientas', 'Estado', 'Fecha alta', 'Notas'];
      const rows = users.map(u =>
        [u.nombre, u.area, u.cargo, u.telefono, u.usuario, u.password, u.correo, (u.herramientas || []).join('|'), u.estado, u.alta, u.notas]
          .map(v => `"${(v || '').replace(/"/g, '""')}"`).join(',')
      );
      const csv = [headers.join(','), ...rows].join('\n');
      const a = document.createElement('a');
      a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csv);
      a.download = 'credenciales_' + today + '.csv';
      a.click();
      showToast('CSV exportado');
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') { closeModal(); closeDetail(); }
    });

    renderTable();
  </script>
</body>
</html>
