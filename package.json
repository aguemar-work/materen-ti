{
  "name": "sistema-ti-tooling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Herramientas de repo (lint/format/type-check) para frontend/src y functions/ — no es un workspace, cada app conserva su propio package.json (frontend/package.json para el runtime de Vue).",
  "scripts": {
    "lint": "eslint frontend/src functions",
    "lint:fix": "eslint frontend/src functions --fix",
    "format": "prettier --write frontend/src functions",
    "format:check": "prettier --check frontend/src functions",
    "typecheck:functions": "deno check --config functions/tsconfig.json functions/credenciales.ts functions/tickets.ts functions/encuestas.ts functions/equipos-fotos.ts",
    "verify:db": "node scripts/snapshot-esquema.mjs --verificar",
    "snapshot": "node scripts/snapshot-esquema.mjs --escribir",
    "deploy": "node scripts/deploy.mjs",
    "test:sql-local": "node scripts/sql-local/verificar-migraciones.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  }
}
