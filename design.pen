xed-width", "width": 520, "content": "main.css .btn-danger:hover fija color:#fff sin condicionar por tema; en oscuro --color-danger es #E88870 (salmón) → 2.57:1, falla AA (izquierda, reproducido tal cual). Propuesta a la derecha: nuevo token --color-danger-hover invariante (#DC2626, $danger.hover aquí) → 4.83:1 en ambos temas. Ficha de desarrollo abajo (Fase 1/2).", "fontFamily": "$font-sans", "fontSize": "$fs-xs", "fontWeight": "normal"}, {"id": "XJmsm", "type": "ref", "ref": "hrkaS", "name": "Peligro — hover corregido (propuesta)", "fill": "$danger.hover", "stroke": "$danger.hover", "descendants": {"B3juYQ": {"icon": "trash-2", "fill": "#FFFFFF"}, "dQ1U1": {"content": "Dar de baja", "fill": "#FFFFFF"}}}]}]}]}, {"type": "frame", "id": "EQOA4", "name": "Formularios", "width": "fill_container", "layout": "vertical", "gap": 22, "children": [{"type": "frame", "id": "M534KZ", "name": "Cabecera", "width": "fill_container", "stroke": "$border", "strokeWidth": {"bottom": 1}, "layout": "vertical", "gap": 4, "padding": [0, 0, 10, 0], "children": [{"type": "text", "id": "u2GWhX", "name": "Título", "fill": "$text.primary", "content": "Formularios", "fontFamily": "$font-display", "fontSize": "$fs-2xl", "fontWeight": "600", "letterSpacing": -0.2}, {"type": "text", "id": "F5Nmht", "name": "Nota", "fill": "$text.secondary", "content": "Rejilla de dos columnas dentro del modal; foco con anillo de acento. El combo teleporta su lista al body.", "fontFamily": "$font-sans", "fontSize": "$fs-base", "fontWeight": "normal"}]}, {"type": "frame", "id": "YGlGE", "name": "Fila", "width": "fill_container", "gap": 32, "children": [{"type": "frame", "id": "HvHdf", "name": "Campo de texto", "width": 260, "layout": "vertical", "gap": 10, "children": [{"type": "text", "id": "RDZ8m", "name": "Etiqueta", "fill": "$text.tertiary", "content": "Campo de texto", "fontFamily": "$font-sans", "fontSize": "$fs-xs", "fontWeight": "600", "letterSpacing": 0.6}, {"id": "z1ZS4", "type": "ref", "ref": "z9Gip4", "n