 "$radius-md", "stroke": "$brand.300", "strokeWidth": 1, "layout": "vertical", "gap": 6, "padding": 12, "children": [{"type": "text", "id": "oLIGb", "name": "Texto", "fill": "$brand.900", "textGrowth": "fixed-width", "width": "fill_container", "content": "Paleta rediseñada a partir de #34D399 (brand.400) y #072E2A (brand.900), los dos colores del logo — sin modificarlos. Reemplaza la paleta anterior (--mat-*) en design.pen. Aún NO está portada a main.css: es una propuesta, no el estado actual de producción.", "fontFamily": "$font-sans", "fontSize": "$fs-xs", "fontWeight": "normal"}]}, {"type": "frame", "id": "lkNYY", "name": "Escala de marca — brand.50 → brand.900", "width": "fill_container", "layout": "vertical", "gap": 10, "children": [{"type": "text", "id": "DokmE", "name": "Etiqueta", "fill": "$text.tertiary", "textGrowth": "fixed-width", "width": "fill_container", "content": "Escala de marca — brand.50 → brand.900", "fontFamily": "$font-sans", "fontSize": "$fs-xs", "fontWeight": "600", "letterSpacing": 0.6}, {"type": "frame", "id": "Btxuo", "name": "Fila", "width": "fill_container", "gap": 10, "children": [{"id": "cmPJg", "type": "ref", "ref": "yxPjs", "name": "brand.50", "descendants": {"c6a5Bx": {"fill": "$brand.50"}, "A5d4s": {"content": "brand.50"}, "rrW2j": {"content": "#ECFDF5/#0A1F1B"}}}, {"id": "KiiCf", "type": "ref", "ref": "yxPjs", "name": "brand.100", "descendants": {"c6a5Bx": {"fill": "$brand.100"}, "A5d4s": {"content": "brand.100"}, "rrW2j": {"content": "#D1FAE5/#0F2D26"}}}, {"id": "qlVj4", "type": "ref", "ref": "yxPjs", "name": "brand.200", "descendants": {"c6a5Bx": {"fill": "$brand.200"}, "A5d4s": {"content": "brand.200"}, "rrW2j": {"content": "#A7F3D0/#164A3D"}}}, {"id": "IDSoZ", "type": "ref", "ref": "yxPjs", "name": "brand.300", "descendants": {"c6a5Bx": {"fill": "$brand.300"}, "A5d4s": {"content": "brand.300"}, "rrW2j": {"content": "#6EE7B7/#1E6650"}}}, {"id": "baPBQ", "type": "ref", "ref": "yxPjs", "name": "brand.400", "descendants": {"c6a5B