# Copiar a .env y completar. La anon key se obtiene con:
#   npx @insforge/cli secrets get ANON_KEY
# (Las claves de cifrado de contraseñas viven en los secrets del servidor
#  — CRED_KEY_V2 / CRED_KEY_LEGACY — y nunca van en el frontend.)
VITE_INSFORGE_URL=https://kjyj8t5t.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=

# Opcional. Observabilidad (D-01) — DSN del proyecto en sentry.io (o
# self-hosted). Sin esta variable, o en "npm run dev", Sentry no se
# inicializa. Si se configura, agregar también el host de ingesta (la
# parte "https://<org>.ingest.<region>.sentry.io" del DSN, sin la clave ni
# el id de proyecto) al connect-src de vercel.json y public/vercel.json.
VITE_SENTRY_DSN=
